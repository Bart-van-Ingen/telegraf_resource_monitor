{
  "configurations": [
    {
      "browse": {
        "path": [
          "/opt/ros/humble/include",
          "/usr/include"
        ],
        "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
        "limitSymbolsToIncludedHeaders": true
      },
      "includePath": [
        "/opt/ros/humble/include/**",
        "/usr/include/**"
      ],
      "name": "ros2",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "compileCommands": "build/compile_commands.json",
      "cStandard": "gnu11",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}